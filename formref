#!/usr/bin/env bash
set -euo pipefail
caller="$PWD"
cd "$(dirname "$0")"
root="$PWD"
action="${1:-dev}"
python_bin="${FORMREF_PYTHON:-$root/backend/venv/bin/python}"
if [[ "${OS:-}" == "Windows_NT" ]]; then python_bin="${FORMREF_PYTHON:-$root/backend/venv/Scripts/python.exe}"; fi
case "$action" in
  help|--help|-h)
    printf '%s\n' 'Usage: ./formref [install|dev|core|build|backend|frontend|serve|mcp|claude|desktop|clipper [--new]|doctor|help]' '       ./formref open <board title or id> [--no-window]' '       ./formref import <folder> [--title NAME] [--recursive] [--no-window]' '       ./formref agents sync [--check]   (copy .claude/skills to .agents/skills and write the agent command reference from the open window'"'"'s catalogue)' '       ./formref i18n check [--strict] | i18n review <folder> [language ...] | i18n apply <sheet.csv> [--dry-run]   (translation coverage, review sheets, reviewed wording back in)' 'The whole app, start to finish: ./build_app (--web, --open, --clean)'
    ;;
  doctor)
    printf '%s\n' 'FormRef local environment'
    for tool in node npm cargo python3; do
      if command -v "$tool" >/dev/null 2>&1; then "$tool" --version; else printf '%s\n' "$tool: missing"; fi
    done
    if [[ -x "$python_bin" ]]; then printf '%s\n' 'Python environment: available'; else printf '%s\n' 'Python environment: missing, run ./formref install'; fi
    if [[ -x "$root/native/formref-core/target/release/formref-core" ]]; then printf '%s\n' 'Rust core: built'; else printf '%s\n' 'Rust core: missing, run ./formref core'; fi
    if command -v curl >/dev/null 2>&1; then curl --connect-timeout 2 --max-time 3 --silent --show-error http://127.0.0.1:8320/api/health || true; fi
    ;;
  install) exec "$root/formref_oc_install" ;;
  core) exec cargo build --release --manifest-path "$root/native/formref-core/Cargo.toml" ;;
  build)
    cargo build --release --manifest-path "$root/native/formref-core/Cargo.toml"
    (cd frontend && npm run build)
    ;;
  backend) exec "$root/backend/boot_backend" ;;
  frontend) exec "$root/frontend/boot_frontend" ;;
  dev)
    "$root/backend/boot_backend" &
    api_pid=$!
    "$root/frontend/boot_frontend" &
    ui_pid=$!
    trap 'kill "$api_pid" "$ui_pid" 2>/dev/null || true' EXIT INT TERM
    while kill -0 "$api_pid" 2>/dev/null && kill -0 "$ui_pid" 2>/dev/null; do sleep 0.25; done
    if ! kill -0 "$api_pid" 2>/dev/null; then wait "$api_pid"; else wait "$ui_pid"; fi
    ;;
  serve)
    cd backend
    exec "$python_bin" -m uvicorn app.main:app --host 127.0.0.1 --port 8320
    ;;
  mcp)
    cd backend
    exec "$python_bin" -m app.mcp_server
    ;;
  open|import|agents)
    cd backend
    FORMREF_CALLER_DIR="$caller" exec "$python_bin" -m app.cli "$action" "${@:2}"
    ;;
  i18n)
    case "${2:-}" in
      check) exec "$python_bin" "$root/frontend/scripts/i18n_check.py" "${@:3}" ;;
      review)
        [[ -n "${3:-}" ]] || { printf '%s\n' 'Usage: ./formref i18n review <folder> [language ...]' >&2; exit 2; }
        out="$3"; [[ "$out" = /* ]] || out="$caller/$out"
        exec "$python_bin" "$root/frontend/scripts/i18n_review.py" "$out" "${@:4}" ;;
      apply)
        [[ -n "${3:-}" ]] || { printf '%s\n' 'Usage: ./formref i18n apply <sheet.csv> [--lang CODE] [--dry-run]' >&2; exit 2; }
        sheet="$3"; [[ "$sheet" = /* ]] || sheet="$caller/$sheet"
        exec "$python_bin" "$root/frontend/scripts/i18n_apply.py" "$sheet" "${@:4}" ;;
      *) printf '%s\n' 'Usage: ./formref i18n check [--strict] | ./formref i18n review <folder> [language ...] | ./formref i18n apply <sheet.csv> [--lang CODE] [--dry-run]' >&2; exit 2 ;;
    esac
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { printf '%s\n' 'Claude Code is not installed: https://claude.com/claude-code' >&2; exit 1; }
    config="$("$python_bin" -c 'import json, sys; print(json.dumps({"mcpServers": {"formref": {"type": "stdio", "command": sys.argv[1], "args": ["mcp"]}}}))' "$root/formref")"
    exec claude --mcp-config "$config" --allowedTools mcp__formref "${@:2}"
    ;;
  clipper)
    cd backend
    exec "$python_bin" -m app.core.clipper "${@:2}"
    ;;
  desktop)
    if [[ "${2:-}" == build ]]; then
      exec "$root/build_app" -- "${@:3}"
    fi
    api_pid=""
    if ! curl --silent --fail --connect-timeout 1 --max-time 2 http://127.0.0.1:8320/api/health >/dev/null 2>&1; then
      "$root/backend/boot_backend" &
      api_pid=$!
    fi
    trap 'if [[ -n "$api_pid" ]]; then kill "$api_pid" 2>/dev/null || true; fi' EXIT INT TERM
    cd frontend
    npm run tauri -- dev --config "$root/src-tauri/tauri.dev.conf.json"
    ;;
  *) printf '%s\n' 'Usage: ./formref [install|dev|core|build|backend|frontend|serve|mcp|claude|desktop|clipper [--new]|open|import|agents sync|i18n]' >&2; exit 2 ;;
esac
